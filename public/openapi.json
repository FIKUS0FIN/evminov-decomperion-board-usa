{
  "openapi": "3.1.0",
  "info": {
    "title": "Evminov Spine Systems USA Public Agent & Commerce API",
    "version": "1.0.0",
    "description": "Public sizing, traction physics, catalog search, MCP, and ACP reservation APIs for evminovusa.com."
  },
  "servers": [{ "url": "https://evminovusa.com" }],
  "paths": {
    "/api/health": {
      "get": { "summary": "API health status", "responses": { "200": { "description": "OK" } } }
    },
    "/api/ask": {
      "get": {
        "summary": "NLWeb natural-language board recommendation",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "lang", "in": "query", "required": false, "schema": { "type": "string", "enum": ["en", "es", "fr", "uk", "ru"] } }
        ],
        "responses": { "200": { "description": "Structured recommendation JSON or Markdown" } }
      }
    },
    "/api/mcp": {
      "post": { "summary": "JSON-RPC 2.0 Model Context Protocol endpoint", "responses": { "200": { "description": "JSON-RPC response" } } }
    },
    "/api/acp/checkout_sessions": {
      "get": { "summary": "List ACP product catalog", "responses": { "200": { "description": "Catalog items" } } },
      "post": { "summary": "Create pre-filled ACP checkout/reservation session", "responses": { "201": { "description": "Session created" } } }
    },
    "/api/submit-order": {
      "post": { "summary": "Submit board reservation or protocol email lead", "responses": { "200": { "description": "Confirmed" } } }
    }
  }
}
